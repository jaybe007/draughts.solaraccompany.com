# =============================================================================
# NAIJA DRAUGHTS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and update values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Environment & URLs
# -----------------------------------------------------------------------------
# Options: 'production', 'staging', 'development'
APP_ENV=production
APP_DEBUG=false

# Full public canonical URL of your deployment (no trailing slash)
APP_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# 2. Database Connection (MySQL / MariaDB)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naija_draughts
DB_USER=naija_db_user
DB_PASS=YourStrongDatabasePassword123!

# -----------------------------------------------------------------------------
# 3. Payment Gateways (Paystack & Flutterwave)
# -----------------------------------------------------------------------------
# Paystack Live / Test Keys (obtain from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave Live / Test Keys (obtain from https://dashboard.flutterwave.com/settings/apis)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Payment Dev Mode: Set to 'false' for live payments with real bank cards/transfers.
# Set to 'true' to use the built-in offline simulation mode.
PAYMENT_DEV_MODE=false

# House Rake Percentages (Defaults: 8% Standard, 4% VIP Oba)
STANDARD_HOUSE_RAKE_PERCENT=8.0
VIP_OBA_HOUSE_RAKE_PERCENT=4.0

# -----------------------------------------------------------------------------
# 4. Email & SMTP Configuration
# -----------------------------------------------------------------------------
# Set to 'true' to send real emails via SMTP
SMTP_ENABLED=true

# SMTP Server Host (e.g., smtp.gmail.com, mail.yourdomain.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP Authentication Credentials
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password-or-smtp-key

# Encryption Protocol: 'tls', 'ssl', or 'none'
SMTP_SECURE=tls

# Sender identity
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME="Naija Draughts Arena"

# Mail Dev Mode: Set to 'false' in production.
# If 'true', emails will be logged to uploads/mail_logs/ instead of sending.
MAIL_DEV_MODE=false

# -----------------------------------------------------------------------------
# 5. Security & Session Settings
# -----------------------------------------------------------------------------
# Enforce HTTPS Secure cookies (Set 'true' if your site uses SSL/HTTPS)
SESSION_SECURE_COOKIE=true

# Secret token for health check and internal maintenance tasks
MAINTENANCE_KEY=YourSecretMaintenanceTokenHere123!
