# =============================================================================
# NAIJA DRAUGHTS - HIGH SECURITY & PERFORMANCE APACHE / CPANEL CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Directory Index & Prevent Directory Listing
# -----------------------------------------------------------------------------
DirectoryIndex index.php index.html
Options -Indexes -MultiViews

# -----------------------------------------------------------------------------
# 2. Block Access to Sensitive Files, Secrets, and Source Code
# -----------------------------------------------------------------------------
<FilesMatch "^(\.env|\.cpanel\.yml|\.git|\.htaccess|\.user\.ini|composer\.(json|lock)|package\.json|.*\.sql|.*\.md|.*\.log|.*\.bak|.*\.sh|.*\.yml|.*\.yaml|.*\.sqlite|.*\.db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# 3. Rewrite Engine & Web Application Firewall Rules
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent execution of any PHP scripts inside uploads or static media directories
    RewriteRule ^uploads/.*\.php$ - [F,L]
    RewriteRule ^assets/uploads/.*\.php$ - [F,L]

    # Block direct listing or download of mail debug logs
    RewriteRule ^uploads/mail_logs/.*$ - [F,L]

    # Block direct web access to internal database migration scripts
    RewriteRule ^database/.*\.sql$ - [F,L]

    # Block Malicious Query Injections (SQLi, PHP Globals, Remote File Inclusion)
    RewriteCond %{QUERY_STRING} (eval\(|base64_encode|base64_decode|<script|GLOBALS|mosConfig_|_REQUEST) [NC,OR]
    RewriteCond %{QUERY_STRING} (UNION.*SELECT|SELECT.*FROM|INSERT.*INTO|DELETE.*FROM|DROP.*TABLE) [NC]
    RewriteRule ^(.*)$ - [F,L]

    # Force HTTPS when available (uncomment if SSL is active on live server)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# -----------------------------------------------------------------------------
# 4. Security HTTP Headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Cross-site scripting (XSS) filter
    Header always set X-XSS-Protection "1; mode=block"

    # Strict Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict Unused Browser Features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self 'https://js.paystack.co' 'https://checkout.flutterwave.com')"
</IfModule>

# -----------------------------------------------------------------------------
# 5. Gzip / Deflate Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# 6. MIME Types & Browser Caching for Static Assets
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg .svgz
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType audio/wav "access plus 1 month"
</IfModule>
